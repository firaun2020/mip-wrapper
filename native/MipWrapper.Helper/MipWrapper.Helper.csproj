<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.InformationProtection.File" Version="1.18.124" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="Microsoft.InformationProtection.File.Ubuntu2204" Version="1.18.124" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
  </ItemGroup>

</Project>
